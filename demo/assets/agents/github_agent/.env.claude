# Github Agent - Claude (Anthropic) configuration
#
# Uses Anthropic Claude for LLM inference via litellm's native Anthropic integration.
# No LLM_API_BASE is needed — litellm routes to the native Anthropic endpoint.
#
# Prerequisite: Create the Kubernetes secret with your API key:
#   kubectl create secret generic claude-secret -n team1 \
#     --from-literal=apikey="<YOUR_ANTHROPIC_API_KEY>"

# LLM configuration
TASK_MODEL_ID=anthropic/claude-sonnet-4-6
# No LLM_API_BASE needed for native Anthropic endpoint
ANTHROPIC_API_KEY='{"valueFrom": {"secretKeyRef": {"name": "claude-secret", "key": "apikey"}}}'

# Agent service
PORT=8000
LOG_LEVEL=DEBUG

# MCP Tool endpoint
MCP_URL=http://github-tool-mcp:9090/mcp
